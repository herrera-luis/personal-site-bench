---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { SITE } from '../../config';
import { getArticles } from '../../lib/articles';
import { LOCALES, type Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = useTranslations(locale);

const articles = await getArticles(locale);
const items = articles.map((a) => ({
  slug: a.slug,
  title: a.entry.data.title,
  dek: a.entry.data.dek,
  pubDate: a.entry.data.pubDate,
}));
---

<BaseLayout title={t('meta.home.title')} description={t('meta.home.desc')} locale={locale}>
  <section class="identity">
    <h1 class="identity__name">{SITE.name}</h1>
    <p class="identity__roles">[{t('site.roles')}]</p>
    <p class="identity__intro">{t('home.intro')}</p>
  </section>
  <section>
    <h2 class="section-heading">{t('articles.heading')}</h2>
    <ArticleList locale={locale} items={items} />
  </section>
</BaseLayout>
