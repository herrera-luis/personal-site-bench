---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getAllPublishedArticleSummaries,
  getArticleLocale,
  getArticleSlug,
  toArticleSummary,
} from '@/lib/articles';
import { articlePath, localePath, translations } from '@/lib/i18n';
import type { Locale } from '@/lib/i18n';

export async function getStaticPaths() {
  const summaries = await getAllPublishedArticleSummaries();
  return summaries.map((summary) => ({
    params: { locale: summary.locale, slug: summary.slug },
    props: { entry: summary.entry, summary },
  }));
}

const { entry } = Astro.props;
const summaries = await getAllPublishedArticleSummaries();
const summary = toArticleSummary(
  entry,
  summaries.map((item) => item.entry),
);
const locale: Locale = getArticleLocale(entry);
const slug = getArticleSlug(entry);
const t = translations[locale];
const { Content } = await entry.render();
const formattedDate = new Intl.DateTimeFormat(locale, {
  dateStyle: 'long',
}).format(entry.data.pubDate);
const formattedUpdatedDate = entry.data.updatedDate
  ? new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(
      entry.data.updatedDate,
    )
  : undefined;
---

<BaseLayout
  locale={locale}
  title={`${entry.data.title} — Luis Herrera`}
  description={entry.data.description}
  canonicalPath={articlePath(locale, slug)}
  alternates={summary.translations}
  type="article"
  image={entry.data.image}
  fallbackPath="/articles/"
>
  <article class="article-body">
    <header>
      <p class="eyebrow">{t.nav.articles}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="meta-list" aria-label="Article metadata">
        <span
          >{t.publishedOn}
          <time datetime={entry.data.pubDate.toISOString()}
            >{formattedDate}</time
          ></span
        >
        {
          formattedUpdatedDate && entry.data.updatedDate && (
            <span>
              {t.updatedOn}{' '}
              <time datetime={entry.data.updatedDate.toISOString()}>
                {formattedUpdatedDate}
              </time>
            </span>
          )
        }
      </div>
      {
        Object.keys(summary.translations).length < 2 && (
          <p class="muted">{t.articleFallback}</p>
        )
      }
    </header>
    <Content />
  </article>
  <p><a href={localePath(locale, '/articles/')}>← {t.allArticles}</a></p>
</BaseLayout>
