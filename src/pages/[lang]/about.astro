---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizedPath, locales, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const alternates = locales.map((l) => ({ lang: l, href: localizedPath(l, 'about') }));

const bio = {
  en: [
    "I'm Luis, a software engineer who enjoys building for the web. This site is where I collect notes, experiments, and longer-form writing.",
    'When I am not writing code, I am usually reading about it — or hiking somewhere with poor cell coverage.',
  ],
  es: [
    'Soy Luis, ingeniero de software al que le gusta construir para la web. En este sitio reúno notas, experimentos y escritos más largos.',
    'Cuando no estoy escribiendo código, suelo estar leyendo sobre él, o de excursión en algún lugar con mala cobertura.',
  ],
}[lang];
---

<BaseLayout
  title={`${t('about.title')} — ${t('site.title')}`}
  description={t('site.tagline')}
  lang={lang}
  path={localizedPath(lang, 'about')}
  alternates={alternates}
  switchPath="about"
>
  <h1>{t('about.title')}</h1>
  {bio.map((p) => <p>{p}</p>)}
</BaseLayout>
