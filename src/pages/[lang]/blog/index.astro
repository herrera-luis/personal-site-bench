---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { useTranslations, localizedPath, locales, type Locale } from '../../../i18n/utils';
import { getArticlesByLocale } from '../../../lib/articles';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const articles = await getArticlesByLocale(lang);
const alternates = locales.map((l) => ({ lang: l, href: localizedPath(l, 'blog') }));
---

<BaseLayout
  title={`${t('blog.title')} — ${t('site.title')}`}
  description={t('blog.description')}
  lang={lang}
  path={localizedPath(lang, 'blog')}
  alternates={alternates}
  switchPath="blog"
>
  <h1>{t('blog.title')}</h1>
  <p class="muted">{t('blog.description')}</p>
  {
    articles.length === 0 ? (
      <p class="muted">{t('blog.empty')}</p>
    ) : (
      articles.map((entry) => <ArticleCard entry={entry} lang={lang} />)
    )
  }
</BaseLayout>
