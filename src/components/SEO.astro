---
import type { Locale } from '../i18n/utils';

export interface AlternateLink {
  lang: Locale;
  href: string;
}

export interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Absolute-from-root canonical path, e.g. "/en/about/". */
  path: string;
  /** hreflang alternates for locales where an equivalent exists. */
  alternates?: AlternateLink[];
  ogType?: 'website' | 'article';
  image?: string;
  /** Article-specific metadata (only used when ogType === 'article'). */
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const {
  title,
  description,
  lang,
  path,
  alternates = [],
  ogType = 'website',
  image,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://example.com');
const canonical = new URL(path, site).href;
const ogImage = image ? new URL(image, site).href : undefined;

// x-default points at the English equivalent when one exists.
const xDefault = alternates.find((a) => a.lang === 'en');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  alternates.map((alt) => (
    <link
      rel="alternate"
      hreflang={alt.lang}
      href={new URL(alt.href, site).href}
    />
  ))
}
{
  xDefault && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(xDefault.href, site).href}
    />
  )
}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang} />
{ogImage && <meta property="og:image" content={ogImage} />}
{
  ogType === 'article' && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  ogType === 'article' && modifiedTime && (
    <meta
      property="article:modified_time"
      content={modifiedTime.toISOString()}
    />
  )
}
{
  ogType === 'article' &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}

<!-- Twitter -->
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
