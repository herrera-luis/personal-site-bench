---
import { t, type Locale } from '../i18n/dictionary';
import { localizedPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---
<nav class="site-nav" aria-label="Primary navigation">
  <a href={localizedPath(locale, { kind: 'home' })}>{copy.nav.home}</a>
  <a href={localizedPath(locale, { kind: 'home' }) + '#articles'}>{copy.nav.articles}</a>
  <a href={localizedPath(locale, { kind: 'about' })}>{copy.nav.about}</a>
</nav>
