---
import { getCounterpartPath, locales } from '@/i18n/config';
import type { Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// The "other" locale (binary en/es switch).
const targetLocale = locales.find((l) => l !== locale) as Locale;
const counterpartPath = getCounterpartPath(Astro.url.pathname, targetLocale);
---

<div class="lang-switcher">
  <a href={counterpartPath} hreflang={targetLocale} aria-label={t('lang.switch.aria')}>
    {t('lang.switch')}
  </a>
</div>
