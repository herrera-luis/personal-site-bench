---
import type { Locale } from '../config/site';
import { LOCALES } from '../config/site';
import { languages } from '../i18n/ui';
import { switchLocalePath, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = useTranslations(locale);
const others = LOCALES.filter((l) => l !== locale);
---
<div class="lang-switcher" aria-label={t('lang.label')}>
  {
    others.map((other) => (
      <a href={switchLocalePath(pathname, other)} hreflang={other} lang={other}>
        {languages[other]}
      </a>
    ))
  }
</div>
