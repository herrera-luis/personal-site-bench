---
import {
  useTranslations,
  localizedPath,
  locales,
  type Locale,
} from '../i18n/utils';

export interface Props {
  lang: Locale;
  /**
   * Path (without locale prefix) to the equivalent page in the other locale,
   * e.g. "about" or "blog/my-post". When omitted, the switcher falls back to
   * the other locale's home page.
   */
  switchPath?: string;
}

const { lang, switchPath } = Astro.props;
const t = useTranslations(lang);
const otherLang = locales.find((l) => l !== lang) as Locale;
const href =
  switchPath !== undefined
    ? localizedPath(otherLang, switchPath)
    : localizedPath(otherLang, '');
---

<a class="lang-switch" href={href} rel="alternate" hreflang={otherLang} lang={otherLang}>
  <span class="sr-only">{t('lang.label')}: </span>{t('lang.switchTo')}
</a>

<style>
  .lang-switch {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
    color: var(--color-text);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .lang-switch:hover {
    border-color: var(--color-accent);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
