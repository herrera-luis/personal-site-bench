---
import { LOCALES, localeNames, type Locale } from '../i18n/ui';
import { useTranslations, localizePath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const path = Astro.url.pathname;
---

<ul class="lang-switcher" aria-label={t('lang.label')}>
  {
    LOCALES.map((l) => (
      <li>
        {l === locale ? (
          <span aria-current="true" lang={l}>
            {localeNames[l]}
          </span>
        ) : (
          <a href={localizePath(path, l)} hreflang={l} lang={l}>
            {localeNames[l]}
          </a>
        )}
      </li>
    ))
  }
</ul>
