---
interface Props {
  title?: string;
}

const { title = 'Note' } = Astro.props;
---
<aside class="article-callout">
  <strong>{title}</strong>
  <div>
    <slot />
  </div>
</aside>

<style>
  .article-callout {
    border-inline-start: 0.25rem solid var(--accent);
    background: var(--surface-muted);
    padding: 1rem;
    margin: 1.5rem 0;
  }

  .article-callout strong {
    display: block;
    margin-bottom: 0.4rem;
  }
</style>
