---
import { useTranslations, localizedPath, type Locale } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

export interface Props {
  lang: Locale;
  /** Path (without locale prefix) to the other-locale equivalent, if any. */
  switchPath?: string;
}

const { lang, switchPath } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname;

const links = [
  { href: localizedPath(lang, ''), label: t('nav.home') },
  { href: localizedPath(lang, 'blog'), label: t('nav.blog') },
  { href: localizedPath(lang, 'about'), label: t('nav.about') },
];

function isActive(href: string): boolean {
  if (href === localizedPath(lang, '')) return current === href;
  return current === href || current.startsWith(href);
}
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={localizedPath(lang, '')}>{t('site.title')}</a>
    <nav aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LanguageSwitcher lang={lang} switchPath={switchPath} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
  }
  nav {
    flex: 1;
  }
  nav ul {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--color-text);
  }
  nav a[aria-current='page'] {
    color: var(--color-accent);
    font-weight: 600;
  }
</style>
