---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  title: string;
  dek: string;
  pubDate: Date;
  description?: string;
  wide?: boolean;
  hideDek?: boolean;
}

const { locale, title, dek, pubDate, description, wide = false, hideDek = false } = Astro.props;
const t = useTranslations(locale);
const dateStr = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(pubDate);
---

<BaseLayout title={title} description={description ?? dek} locale={locale} wide={wide}>
  <article class="article">
    <header class="article-header">
      <h1>{title}</h1>
      {!hideDek && <h3 class="dek">{dek}</h3>}
      <p class="article-meta">
        {t('article.by')} {SITE.author}
        {' · '}
        <time datetime={pubDate.toISOString()}>{dateStr}</time>
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
