---
import type { Locale } from '../i18n/ui';
import { localeLangTags } from '../i18n/ui';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Site-root-relative path of the current page. */
  path: string;
  /** Map of locale -> path for this same logical page (for hreflang + switcher). */
  alternatePaths: Partial<Record<Locale, string>>;
  /** Map of locale -> href for the language switcher (may fall back to home). */
  switcherTargets: Record<Locale, string>;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  locale,
  title,
  description,
  path,
  alternatePaths,
  switcherTargets,
  ogType,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang={localeLangTags[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={title}
      href={`/${locale}/rss.xml`}
    />
    <SEO
      locale={locale}
      title={title}
      description={description}
      path={path}
      alternatePaths={alternatePaths}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
  </head>
  <body>
    <Header locale={locale} currentPath={path} switcherTargets={switcherTargets} />
    <main class="site-main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
