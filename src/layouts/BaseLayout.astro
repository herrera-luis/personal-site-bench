---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO, { type AlternateLink } from '../components/SEO.astro';
import { useTranslations, type Locale } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Canonical absolute-from-root path for this page, e.g. "/en/about/". */
  path: string;
  /** hreflang alternates for locales where an equivalent exists. */
  alternates?: AlternateLink[];
  /** Path (no locale prefix) to the other-locale equivalent for the switcher. */
  switchPath?: string;
  ogType?: 'website' | 'article';
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
}

const {
  title,
  description,
  lang,
  path,
  alternates = [],
  switchPath,
  ogType = 'website',
  image,
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;

const t = useTranslations(lang);
const rssPath = `/${lang}/rss.xml`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('site.title')} (${lang})`}
      href={rssPath}
    />
    <SEO
      title={title}
      description={description}
      lang={lang}
      path={path}
      alternates={alternates}
      ogType={ogType}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <Header lang={lang} switchPath={switchPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
