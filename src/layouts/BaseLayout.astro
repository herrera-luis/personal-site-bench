---
import { useTranslations, type Locale } from '../i18n/ui';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hreflang from '../components/Hreflang.astro';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  ogType?: string;
}

const { lang, title, description, ogType = 'website' } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? 'https://personal-site.example').href;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={t('site.name')} />

    <!-- hreflang alternates: en, es, x-default -->
    <Hreflang pathname={pathname} />

    <!-- Per-locale RSS discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t('site.name')} (${lang})`}
      href={`/${lang}/rss.xml`}
    />
  </head>
  <body>
    <div class="layout">
      <SiteHeader lang={lang} pathname={pathname} />
      <main class="content">
        <slot />
      </main>
      <SiteFooter lang={lang} />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --font-body: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial,
      sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --measure: 68ch;

    --bg: #ffffff;
    --fg: #1a1a1a;
    --muted: #5c5c5c;
    --accent: #0b5cad;
    --border: #e4e4e4;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121212;
      --fg: #e9e9e9;
      --muted: #a3a3a3;
      --accent: #7db3ec;
      --border: #2a2a2a;
    }
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-body);
    line-height: 1.6;
    color-scheme: light dark;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-size: 1.05rem;
  }

  .layout {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .content {
    flex: 1 0 auto;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* Header */
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--fg);
  }
  .brand-name {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .brand-roles {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: baseline;
  }
  .nav-lang {
    padding-left: 0.5rem;
    border-left: 1px solid var(--border);
  }

  /* Footer */
  .site-footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .footer-links {
    display: flex;
    gap: 1rem;
    list-style: none;
    margin: 0 0 0.5rem;
    padding: 0;
  }

  /* Identity strip */
  .identity {
    margin-bottom: 2.5rem;
  }
  .identity h1 {
    margin: 0;
    font-size: 2rem;
  }
  .identity .roles {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  /* Article list */
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .article-list-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .article-list-title {
    margin: 0 0 0.25rem;
    font-size: 1.3rem;
  }
  .article-list-title a {
    text-decoration: none;
    color: var(--fg);
  }
  .article-list-dek {
    margin: 0 0 0.35rem;
    color: var(--muted);
  }
  .article-list-meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .empty {
    color: var(--muted);
    font-style: italic;
  }

  /* Article reading view */
  .article {
    margin: 0 auto;
  }
  .article.variant-wide {
    max-width: none;
  }
  .article-header h1 {
    font-size: 2.2rem;
    margin: 0 0 0.35rem;
    line-height: 1.2;
  }
  .article-header .dek {
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }
  .article-meta {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 2rem;
  }
  .article-body :is(h2, h3) {
    margin-top: 2rem;
  }
  .article-body img {
    max-width: 100%;
    height: auto;
  }

  /* Callout shared component */
  .callout {
    border-left: 3px solid var(--accent);
    padding: 0.5rem 1rem;
    margin: 1.5rem 0;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .callout-warning {
    border-left-color: #c25b00;
    background: color-mix(in srgb, #c25b00 8%, transparent);
  }
</style>
